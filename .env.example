# Copy to .env for local runs. `.env` is gitignored.
# In Devin Cloud these live in the Secrets store (Settings → Secrets) and are injected as
# environment variables into every session — never pasted into prompts or committed.

# --- secrets (Devin secret name = variable name) ---
OPENAI_API_KEY=                 # optional; enables live LLM summaries / NL queries. Absent → deterministic rules.
WEBHOOK_SIGNING_SECRET=         # HMAC key for outbound webhook payloads. Absent → payloads marked "unsigned".

# --- non-secret configuration ---
OPENAI_MODEL=gpt-4o-mini
DB_PATH=data.db                 # SQLite for the prototype; a Postgres DSN would also be a secret
TOOLS_DIR=tools
KNOWLEDGE_DIR=knowledge
